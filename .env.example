CUPS_SERVER=http://cups-test:631
# Optional: only required if cups-test enforces authentication for admin
# operations (pause/resume/enable/disable/print/cancel). Read-only endpoints
# (printer list/detail) work without these. The user must exist on cups-test
# and belong to the lpadmin (or SystemGroup) group.
CUPS_USER=
CUPS_PASSWORD=
# The actual bearer token enforced on /api/printers, /api/print, /api/jobs
# (Authorization: Bearer <key>). Generate a real one: openssl rand -hex 32
# You never type this in directly — the Web UI login below exchanges
# ADMIN_USERNAME/ADMIN_PASSWORD for this value automatically.
PRINT_API_KEY=change-this-key
# Web UI login credentials (POST /api/auth/login). Change both from the
# defaults — this is a real password, not just a placeholder to note.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
MAX_UPLOAD_SIZE_MB=50
POLL_INTERVAL_SECONDS=5
CORS_ORIGINS=http://localhost:8080
TZ=Asia/Jakarta
FRONTEND_PORT=8080
BACKEND_PORT=8000
